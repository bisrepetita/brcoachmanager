rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Fonctions utilitaires ────────────────────────────────────────────────

    function isAuth() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuth() && 'admin' in userDoc().roles;
    }

    function isCoach() {
      return isAuth() && ('coach' in userDoc().roles || 'admin' in userDoc().roles);
    }

    function isClient() {
      return isAuth() && 'client' in userDoc().roles;
    }

    function isAssignedCoach(sessionData) {
      return isAuth() && request.auth.uid in sessionData.coachIds;
    }

    function canReadClient(clientData) {
      return isAdmin() || (isCoach() && (
        clientData.visibleToCoachIds.size() == 0 ||
        request.auth.uid in clientData.visibleToCoachIds
      ));
    }

    // ─── users ────────────────────────────────────────────────────────────────

    match /users/{userId} {
      allow read: if isAdmin() || (isAuth() && request.auth.uid == userId);
      // Coaches peuvent lire tous les profils (pour afficher les noms dans le calendrier)
      allow read: if isCoach();
      // Coach peut mettre à jour ses propres champs de profil
      allow update: if isAdmin() || (
        isAuth() && request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['fcmToken', 'googleCalendarUrl', 'icalSecret', 'updatedAt'])
      );
      allow create, delete: if isAdmin();
    }

    // ─── clients ─────────────────────────────────────────────────────────────

    match /clients/{clientId} {
      allow read: if canReadClient(resource.data);
      allow create: if isCoach();
      // Un client peut renseigner son propre numéro de téléphone (ex: après une connexion Google,
      // qui ne fournit pas ce champ) — rien d'autre, pour éviter qu'il modifie ses propres crédits,
      // remises, etc.
      allow update: if isAdmin() || (isCoach() && canReadClient(resource.data)) || (
        isClient() && resource.data.uid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phone', 'updatedAt'])
      );
      allow delete: if isAdmin();
    }

    // ─── clientGroups ────────────────────────────────────────────────────────

    match /clientGroups/{groupId} {
      allow read: if isCoach();
      allow create, update, delete: if isAdmin();
    }

    // ─── locations ───────────────────────────────────────────────────────────

    match /locations/{locationId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdmin();
    }

    // ─── buildings (regroupe des Lieux au même endroit géographique) ────────

    match /buildings/{buildingId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdmin();
    }

    // ─── services ────────────────────────────────────────────────────────────

    match /services/{serviceId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdmin();
    }

    // ─── subscriptionPlans (catalogue des plans d'abonnement) ────────────────

    match /subscriptionPlans/{planId} {
      // Consultable sans connexion pour les plans publics et actifs (page /subscriptions), comme
      // le Planning — la requête côté client filtre explicitement sur ces deux champs, ce qui
      // permet à Firestore de prouver la requête sûre même pour une requête non authentifiée
      // (isAuth() est statiquement faux dans ce cas, donc évalué sans avoir besoin des documents).
      allow read: if isAuth() || (resource.data.isPublic == true && resource.data.active == true);
      allow create, update, delete: if isAdmin();
    }

    // ─── discounts (codes promo & rabais clients) ───────────────────────────

    match /discounts/{discountId} {
      // Un client ne voit que ses propres rabais attribués (pas les codes promo génériques,
      // validés côté serveur via /api/group-sessions/enroll) ; les coachs voient tout.
      allow read: if isCoach() || (
        isClient() && resource.data.kind == 'client' &&
        get(/databases/$(database)/documents/clients/$(resource.data.clientId)).data.uid == request.auth.uid
      );
      allow create, delete: if isAdmin();
      // Un coach peut uniquement incrémenter le compteur d'usage (application manuelle sur
      // une séance privée/vente) — toute autre modification (valeur, dates, cible) est admin.
      allow update: if isAdmin() || (
        isCoach() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usesCount', 'updatedAt'])
      );

      match /redemptions/{redemptionId} {
        allow read, create: if isCoach();
      }
    }

    // ─── clientSubscriptions (abonnements attribués/achetés par un client) ──

    match /clientSubscriptions/{subscriptionId} {
      // Comparaison directe sur resource.data.uid (pas de get()) : cf. commentaire identique sur
      // consumptions ci-dessous — nécessaire pour que la requête `list` côté client (avec un filtre
      // explicite where('uid','==',...)) soit prouvable sûre par Firestore, même à résultat vide.
      allow read: if isCoach() || (isClient() && resource.data.uid == request.auth.uid);
      // L'attribution manuelle passe par une transaction client (voir subscription.service.ts) qui
      // annule l'abonnement actif précédent puis active le nouveau — réservé à l'admin, comme les
      // remises. L'achat en self-service est activé côté serveur (Admin SDK) par le webhook Stripe,
      // qui contourne ces règles.
      allow create, update, delete: if isAdmin();

      match /consumptions/{consumptionId} {
        // Comparaison directe sur resource.data.uid (pas de get()) : une règle qui a besoin d'un
        // get() pour vérifier l'accès empêche Firestore de prouver qu'une requête `list` est sûre
        // sans filtre explicite correspondant, même quand le résultat est vide — la requête
        // côté client filtre donc explicitement where('uid','==', request.auth.uid).
        allow read: if isCoach() || (isClient() && resource.data.uid == request.auth.uid);
        allow write: if isAdmin();
      }
    }

    // ─── sessions ────────────────────────────────────────────────────────────

    match /sessions/{sessionId} {
      allow read: if isAdmin() || isAssignedCoach(resource.data);

      allow create: if isAdmin() || (isCoach() && request.auth.uid in request.resource.data.coachIds);

      allow update: if isAdmin() || (
        isAssignedCoach(resource.data) &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['coachIds', 'priceSnapshot', 'roomRentalSnapshot', 'locationId', 'serviceId'])
      );

      // Coach peut supprimer ses propres séances
      allow delete: if isAdmin() || isAssignedCoach(resource.data);
    }

    // ─── groupSessions (séances collectives auto-inscription client) ────────

    match /groupSessions/{groupSessionId} {
      // Un client ne voit que les séances publiées et non annulées ; les coachs voient tout.
      allow read: if isCoach() || (
        isClient() && resource.data.isPublic == true && resource.data.status != 'cancelled'
      );

      allow create: if isCoach();

      // Les inscriptions (enrollments) ne sont modifiables que côté serveur (Admin SDK,
      // routes /api/group-sessions/*) qui contourne ces règles — un coach ne peut jamais
      // toucher ce champ depuis le client web, et un client n'a aucun accès en écriture ici.
      allow update: if isAdmin() || (
        isCoach() && request.auth.uid in resource.data.coachIds &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['enrollments'])
      );

      allow delete: if isAdmin();
    }

    // ─── recurrences ─────────────────────────────────────────────────────────

    match /recurrences/{recurrenceId} {
      allow read: if isAdmin() || (isCoach() && request.auth.uid in resource.data.coachIds);
      allow create: if isCoach();
      allow update, delete: if isAdmin() || (isCoach() && request.auth.uid in resource.data.coachIds);
    }

    // ─── groupSessionRecurrences ─────────────────────────────────────────────

    match /groupSessionRecurrences/{recurrenceId} {
      allow read: if isAdmin() || (isCoach() && request.auth.uid in resource.data.coachIds);
      allow create: if isCoach();
      allow update, delete: if isAdmin() || (isCoach() && request.auth.uid in resource.data.coachIds);
    }

    // ─── availabilitySlots ───────────────────────────────────────────────────

    match /availabilitySlots/{slotId} {
      // Tous les coachs voient tous les créneaux (coordination)
      allow read: if isCoach();
      allow create: if isCoach() && request.resource.data.coachId == request.auth.uid;
      allow update, delete: if isAdmin() || (isCoach() && resource.data.coachId == request.auth.uid);
    }

    // ─── recurringAvailabilities ─────────────────────────────────────────────

    match /recurringAvailabilities/{id} {
      allow read: if isCoach();
      allow create: if isCoach() && request.resource.data.coachId == request.auth.uid;
      allow update, delete: if isAdmin() || (isCoach() && resource.data.coachId == request.auth.uid);
    }

    // ─── creditTransactions ──────────────────────────────────────────────────

    match /creditTransactions/{txId} {
      allow read, write: if isAdmin() || isCoach();
    }

    // ─── roomRentalPayments ──────────────────────────────────────────────────

    match /roomRentalPayments/{id} {
      // Coach peut voir ses propres versements
      allow read: if isAdmin() || (isAuth() && resource.data.coachId == request.auth.uid);
      allow write: if isAdmin();
    }

    // ─── settings ────────────────────────────────────────────────────────────

    match /settings/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // ─── sales ───────────────────────────────────────────────────────────────

    match /sales/{saleId} {
      allow read: if isAdmin() || (isCoach() && request.auth.uid in resource.data.coachIds);
      allow create: if isCoach() && request.auth.uid in request.resource.data.coachIds;
      allow update: if isAdmin() || (isCoach() && request.auth.uid in resource.data.coachIds);
      allow delete: if isAdmin() || (isCoach() && request.auth.uid in resource.data.coachIds);
    }

    // ─── activityLogs ─────────────────────────────────────────────────────────

    match /activityLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isCoach();
    }

    // Écrit uniquement par le webhook /api/classpass-webhook (Admin SDK, contourne ces règles) —
    // aucune écriture cliente n'est légitime ici.
    match /classPassImports/{importId} {
      allow read: if isAdmin();
    }

    // ─── notifications ────────────────────────────────────────────────────────

    match /notifications/{notifId} {
      allow read, update: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAdmin();
    }

  }
}
